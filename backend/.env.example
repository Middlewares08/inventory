NODE_ENV=development
PORT=5000

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=inventory

# Used by node-pg-migrate and as a fallback in src/config/db.js
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inventory

# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGIN=http://localhost:5173

# Secret used to sign JWTs issued on login — generate a long random string per environment,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
